{
	"name": "harmonia",
	"private": true,
	"workspaces": ["apps/*", "packages/*"],
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"dev:api": "concurrently -n api,trigger -c blue,green \"turbo -F api dev\" \"pnpm trigger:dev\"",
		"dev:web": "turbo -F web dev",
		"dev:dashboard": "turbo -F dashboard dev",
		"dev:aw": "concurrently -n api,web,trigger -c blue,yellow,green \"turbo run dev --filter=api --filter=web\" \"pnpm trigger:dev\"",
		"dev:ad": "concurrently -n api,dashboard,trigger -c blue,cyan,green \"turbo run dev --filter=api --filter=dashboard\" \"pnpm trigger:dev\"",
		"dev:all": "concurrently -n api,web,dashboard,trigger -c blue,yellow,cyan,green \"turbo run dev --filter=api --filter=web --filter=dashboard\" \"pnpm trigger:dev\"",
		"build": "turbo build",
		"db:push": "turbo -F @harmonia/db db:push",
		"db:studio": "turbo -F @harmonia/db db:studio",
		"db:generate": "turbo -F @harmonia/db db:generate",
		"db:migrate": "turbo -F @harmonia/db db:migrate",
		"check": "biome check --write .",
		"lint": "biome lint --write .",
		"format": "biome format --write .",
		"fix:all": "biome check --write --unsafe . || true",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"db:migrate:direct": "pnpm exec drizzle-kit migrate --config=packages/db/drizzle.config.ts",
		"db:mark-migrations-applied": "turbo -F @harmonia/db db:mark-migrations-applied",
		"sync-repo": "chmod +x scripts/sync-repo.sh && scripts/sync-repo.sh",
		"db:setup": "docker compose -f ./docker/docker-compose.yml up -d && pnpm db:push",
		"trigger:dev": "npx trigger.dev@latest dev --config apps/api/trigger.config.ts"
	},
	"dependencies": {
		"@harmonia/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@harmonia/config": "workspace:*",
		"@types/node": "^22.13.14",
		"concurrently": "^9.1.2",
		"turbo": "^2.8.12",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.26.1"
}
