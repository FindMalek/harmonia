# =============================================================================
# HARMONIA - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Neon or local Docker)
# Required by: DB package, API app
HARMONIA_DATABASE_URL="postgresql://postgres:password@localhost:5433/harmonia"

# -----------------------------------------------------------------------------
# BASE CONFIGURATION
# -----------------------------------------------------------------------------
# Node environment (development, production, local)
NEXT_PUBLIC_HARMONIA_NODE_ENV="local"

# API URL - Base URL for API requests (auth, RPC)
# Required by: All apps. API runs on this URL.
NEXT_PUBLIC_HARMONIA_API_URL="http://127.0.0.1:3002"

# Allowed origin pattern for CORS validation (*, URL, or wildcard like *.domain.com)
NEXT_PUBLIC_HARMONIA_ALLOWED_ORIGIN="*"

# -----------------------------------------------------------------------------
# APPLICATION URLS
# -----------------------------------------------------------------------------
# Web app URL
NEXT_PUBLIC_HARMONIA_WEB_URL="http://127.0.0.1:3001"

# Dashboard app URL
NEXT_PUBLIC_HARMONIA_DASHBOARD_URL="http://127.0.0.1:3003"

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Better Auth secret (generate with: openssl rand -base64 32)
HARMONIA_BETTER_AUTH_SECRET="your-secret-key-here-generate-with-openssl"

# Spotify OAuth (optional)
# Redirect URI: {NEXT_PUBLIC_HARMONIA_API_URL}/api/auth/callback/spotify
HARMONIA_SPOTIFY_CLIENT_ID=""
HARMONIA_SPOTIFY_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# AI / EMBEDDINGS (Optional)
# -----------------------------------------------------------------------------
HARMONIA_OPENAI_API_KEY=""
HARMONIA_GROQ_API_KEY=""

# -----------------------------------------------------------------------------
# CRON (Optional)
# -----------------------------------------------------------------------------
# Secret for Vercel cron to trigger organize.run
HARMONIA_CRON_SECRET=""

# -----------------------------------------------------------------------------
# BACKGROUND JOBS (Trigger.dev)
# -----------------------------------------------------------------------------
# Secret key from your Trigger.dev project dashboard
# Get from: https://cloud.trigger.dev -> Project -> API Keys
# `pnpm trigger:dev` maps this to TRIGGER_SECRET_KEY for the Trigger CLI.
HARMONIA_TRIGGER_SECRET_KEY=""

# Project reference from your Trigger.dev project dashboard (non-empty; required for pnpm trigger:dev)
# Get from: https://cloud.trigger.dev -> Project -> Settings
HARMONIA_TRIGGER_PROJECT_REF=""

# -----------------------------------------------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------------------------------------------
HARMONIA_OTEL_SERVICE_NAME="harmonia"
HARMONIA_OTEL_SAMPLING_RATE="1"
HARMONIA_OTEL_ENABLED="false"
HARMONIA_OTEL_EXPORTER_OTLP_ENDPOINT=""
HARMONIA_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=""
HARMONIA_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=""
HARMONIA_OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=""
HARMONIA_OTEL_EXPORTER_OTLP_HEADERS=""
HARMONIA_OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
HARMONIA_OTEL_EXPORTER_OTLP_COMPRESSION="gzip"
