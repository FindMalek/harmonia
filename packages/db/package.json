{
	"name": "@harmonia/db",
	"version": "0.0.0",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"build": "tsc --noEmit",
		"db:push": "node scripts/ensure-pgvector.mjs && drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"db:mark-migrations-applied": "node scripts/mark-migrations-applied.mjs",
		"db:reset": "tsx scripts/db-reset.ts",
		"db:reset:all": "tsx scripts/db-reset.ts --all",
		"db:reset:embeddings": "tsx scripts/reset-embeddings.ts",
		"db:nuke": "node scripts/db-nuke.mjs",
		"db:seed": "tsx scripts/seed-admin.ts"
	},
	"dependencies": {
		"@harmonia/env": "workspace:*",
		"@neondatabase/serverless": "^1.1.0",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"pg": "^8.21.0",
		"ws": "^8.21.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@harmonia/config": "workspace:*",
		"@types/pg": "^8.20.0",
		"@types/ws": "^8.18.1",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.22.4",
		"typescript": "catalog:"
	}
}
