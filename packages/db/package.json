{
	"name": "@harmonia/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"build": "tsc --noEmit",
		"db:push": "node scripts/ensure-pgvector.mjs && drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"db:mark-migrations-applied": "node scripts/mark-migrations-applied.mjs",
		"db:reset": "tsx scripts/db-reset.ts",
		"db:nuke": "node scripts/db-nuke.mjs"
	},
	"dependencies": {
		"@harmonia/env": "workspace:*",
		"@neondatabase/serverless": "^1.0.2",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"pg": "^8.14.1",
		"ws": "^8.18.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@harmonia/config": "workspace:*",
		"@types/pg": "^8.11.13",
		"@types/ws": "^8.5.13",
		"drizzle-kit": "^0.31.8",
		"tsx": "^4.21.0",
		"typescript": "catalog:"
	}
}
