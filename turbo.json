{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": [
		"HARMONIA_DATABASE_URL",
		"NEXT_PUBLIC_HARMONIA_NODE_ENV",
		"NEXT_PUBLIC_HARMONIA_API_URL",
		"NEXT_PUBLIC_HARMONIA_ALLOWED_ORIGIN",
		"HARMONIA_BETTER_AUTH_SECRET",
		"NEXT_PUBLIC_HARMONIA_WEB_URL",
		"NEXT_PUBLIC_HARMONIA_DASHBOARD_URL",
		"HARMONIA_SPOTIFY_CLIENT_ID",
		"HARMONIA_SPOTIFY_CLIENT_SECRET",
		"HARMONIA_OPENAI_API_KEY",
		"HARMONIA_GROQ_API_KEY",
		"HARMONIA_CRON_SECRET",
		"HARMONIA_OTEL_SERVICE_NAME",
		"HARMONIA_OTEL_SAMPLING_RATE",
		"HARMONIA_OTEL_ENABLED",
		"HARMONIA_OTEL_EXPORTER_OTLP_ENDPOINT",
		"HARMONIA_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
		"HARMONIA_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT",
		"HARMONIA_OTEL_EXPORTER_OTLP_LOGS_ENDPOINT",
		"HARMONIA_OTEL_EXPORTER_OTLP_HEADERS",
		"HARMONIA_OTEL_EXPORTER_OTLP_PROTOCOL",
		"HARMONIA_OTEL_EXPORTER_OTLP_COMPRESSION",
		"HARMONIA_ALLOW_DB_RESET_REMOTE",
		"HARMONIA_ALLOW_DB_NUKE"
	],
	"globalPassThroughEnv": [
		"HARMONIA_DATABASE_URL",
		"NEXT_PUBLIC_HARMONIA_NODE_ENV",
		"NEXT_PUBLIC_HARMONIA_API_URL",
		"NEXT_PUBLIC_HARMONIA_ALLOWED_ORIGIN",
		"HARMONIA_BETTER_AUTH_SECRET",
		"NEXT_PUBLIC_HARMONIA_WEB_URL",
		"NEXT_PUBLIC_HARMONIA_DASHBOARD_URL",
		"HARMONIA_SPOTIFY_CLIENT_ID",
		"HARMONIA_SPOTIFY_CLIENT_SECRET",
		"HARMONIA_OPENAI_API_KEY",
		"HARMONIA_GROQ_API_KEY",
		"HARMONIA_CRON_SECRET",
		"HARMONIA_OTEL_SERVICE_NAME",
		"HARMONIA_OTEL_SAMPLING_RATE",
		"HARMONIA_OTEL_ENABLED",
		"HARMONIA_OTEL_EXPORTER_OTLP_ENDPOINT",
		"HARMONIA_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
		"HARMONIA_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT",
		"HARMONIA_OTEL_EXPORTER_OTLP_LOGS_ENDPOINT",
		"HARMONIA_OTEL_EXPORTER_OTLP_HEADERS",
		"HARMONIA_OTEL_EXPORTER_OTLP_PROTOCOL",
		"HARMONIA_OTEL_EXPORTER_OTLP_COMPRESSION",
		"HARMONIA_ALLOW_DB_RESET_REMOTE",
		"HARMONIA_ALLOW_DB_NUKE"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:mark-migrations-applied": {
			"cache": false
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:reset": {
			"cache": false
		},
		"db:reset:all": {
			"cache": false
		},
		"db:nuke": {
			"cache": false
		}
	}
}
